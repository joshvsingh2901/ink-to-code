FRONTEND_ORIGINS=http://localhost:3000
GEMINI_API_KEY=
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-flash-lite
GEMINI_TEST_GENERATION_MODEL=gemini-3.5-flash-lite
ENVIRONMENT=development
ENABLE_HSTS=false
# CPP_EXECUTION_PROVIDER selects the isolated C++ execution backend:
# "docker" (the local default -- requires the inktocode-cpp-runner image
# built from runner/) or "modal" (isolated cloud sandboxes -- requires
# MODAL_TOKEN_ID/MODAL_TOKEN_SECRET and MODAL_RUNNER_IMAGE below; see
# docs/internal/MODAL_DEPLOYMENT.md).
CPP_EXECUTION_PROVIDER=docker
CPP_RUNNER_IMAGE=inktocode-cpp-runner
CPP_RUNNER_MEMORY=256m
CPP_RUNNER_CPUS=1.0
CPP_RUNNER_PIDS=32
CPP_RUNNER_USER=runner
CPP_DOCKER_COMPILE_TIMEOUT_SECONDS=30
CPP_DOCKER_RUN_TIMEOUT_SECONDS=8
CPP_DOCKER_VALGRIND_TIMEOUT_SECONDS=20
# Modal cloud execution provider (only used when CPP_EXECUTION_PROVIDER=modal).
# MODAL_TOKEN_ID and MODAL_TOKEN_SECRET are read directly by the modal SDK
# (not by app/config.py) -- see docs/internal/MODAL_DEPLOYMENT.md for how to
# create them. Leave everything below blank for local Docker-only use.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_APP_NAME=inktocode-cpp-runner
MODAL_RUNNER_IMAGE=
MODAL_SANDBOX_TIMEOUT_SECONDS=600
MODAL_SANDBOX_IDLE_TIMEOUT_SECONDS=120
MAX_SOURCE_CHARS=100000
MAX_TEST_VALUE_CHARS=2000
MAX_REQUEST_BYTES=12582912
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AI_PER_WINDOW=10
RATE_LIMIT_AI_WINDOW_SECONDS=300
RATE_LIMIT_COMPILE_PER_MINUTE=60
RATE_LIMIT_GLOBAL_AI_PER_MINUTE=30
TRUSTED_PROXY_COUNT=0
CPP_MAX_CONCURRENT_JOBS=2
AI_MAX_CONCURRENT_CALLS=2
CPP_ACQUIRE_TIMEOUT_SECONDS=10
AI_ACQUIRE_TIMEOUT_SECONDS=20
